# # Supabase project credentials
# # Find these in your Supabase project: Settings > API
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key


# Supabase project credentials
# Find these in your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ----------------------------------------------------------------------------
# Nova AI — server-side only. Do NOT prefix these with VITE_: a VITE_ prefix
# tells Vite to bundle the value into the browser JS, which would leak these
# secrets to every visitor. These are only read by api/nova-ai.js, which runs
# as a Vercel serverless function and never ships to the client.
# ----------------------------------------------------------------------------

GEMINI_API_KEY=your-anthropic-api-key
GEMINI_MODEL=gemini-2.5-flash

# Same Supabase project as above, but the SERVICE ROLE key (Settings > API >
# service_role). This lets the backend search products server-side. Keep it
# secret — it bypasses row-level security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
